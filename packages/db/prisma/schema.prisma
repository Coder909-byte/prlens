generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (macOS) - "rhel-openssl-3.0.x" is what Vercel's
  // Node serverless runtime actually needs; without it, the client that
  // works everywhere in dev throws PrismaClientInitializationError only in
  // production, since generate defaults to whichever platform *ran* it.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReviewMode {
  DIFF_ONLY
  REPO_AWARE
}

enum ReviewStatus {
  SUCCEEDED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingCategory {
  BUG
  SECURITY
  MISSING_TEST
  STYLE
}

// One row per posted review (one pg-boss job). Token/cost/latency numbers
// here are what the eval harness (M2) reads to compute cost-per-review.
model Review {
  id             String       @id @default(cuid())
  // BigInt: GitHub's numeric installation IDs are 64-bit, past Postgres's
  // INT4 range. pullNumber below is different - it's the small, per-repo
  // sequential PR number shown in the URL, not a GitHub-issued global ID.
  installationId BigInt
  owner          String
  repo           String
  pullNumber     Int
  headSha        String
  baseSha        String
  mode           ReviewMode   @default(DIFF_ONLY)
  status         ReviewStatus

  // The provider/model actually attempted first (LLM_PROVIDER/LLM_MODEL at
  // the time of the review).
  primaryLlmProvider String
  primaryLlmModel    String

  // The provider/model that actually produced this review - differs from
  // primaryLlm* only when a fallback provider (LLM_FALLBACK_PROVIDERS) had
  // to take over after the primary failed with a retryable error.
  llmProvider    String
  llmModel       String

  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal? @db.Decimal(10, 6)
  latencyMs    Int

  skippedFiles Json     @default("[]")
  errorMessage String?
  createdAt    DateTime @default(now())

  // The GitHub review this row's Findings were posted as, if posting
  // succeeded. Used to find and supersede a PR's previous PRLens review
  // (and clean up its now-stale inline comments) when a new commit arrives,
  // instead of stacking a fresh review on top of it every time.
  //
  // BigInt, not Int: GitHub's numeric IDs (review/comment/PR/installation
  // IDs) are 64-bit and routinely exceed Postgres's INT4 range (2^31-1) -
  // installationId below learned this the same way. Audit any new
  // GitHub-issued ID column against this before assuming Int is enough.
  githubReviewId BigInt?

  findings Finding[]

  @@unique([owner, repo, pullNumber, headSha])
  @@index([owner, repo, pullNumber])
}

model Finding {
  id           String          @id @default(cuid())
  reviewId     String
  review       Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file         String
  line         Int
  severity     FindingSeverity
  category     FindingCategory
  explanation  String
  suggestedFix String
  confidence   Float
  postedInline Boolean
  // Populated only for repo-aware findings once apps/worker gains repo-aware
  // posting (M3 built repo-aware review as eval-only infrastructure - it
  // never ran in production). Null for every row today; the dashboard
  // renders its "no context retrieved" state whenever this is null.
  retrievedContext Json?

  @@index([reviewId])
}
