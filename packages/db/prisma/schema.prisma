generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReviewMode {
  DIFF_ONLY
  REPO_AWARE
}

enum ReviewStatus {
  SUCCEEDED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingCategory {
  BUG
  SECURITY
  MISSING_TEST
  STYLE
}

// One row per posted review (one BullMQ job). Token/cost/latency numbers
// here are what the eval harness (M2) reads to compute cost-per-review.
model Review {
  id             String       @id @default(cuid())
  installationId BigInt
  owner          String
  repo           String
  pullNumber     Int
  headSha        String
  baseSha        String
  mode           ReviewMode   @default(DIFF_ONLY)
  status         ReviewStatus

  // Which LLM produced this review - providers are swappable (see
  // packages/reviewer), so we record what actually ran.
  llmProvider    String
  llmModel       String

  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal? @db.Decimal(10, 6)
  latencyMs    Int

  skippedFiles Json     @default("[]")
  errorMessage String?
  createdAt    DateTime @default(now())

  findings Finding[]

  @@unique([owner, repo, pullNumber, headSha])
  @@index([owner, repo, pullNumber])
}

model Finding {
  id           String          @id @default(cuid())
  reviewId     String
  review       Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file         String
  line         Int
  severity     FindingSeverity
  category     FindingCategory
  explanation  String
  suggestedFix String
  confidence   Float
  postedInline Boolean

  @@index([reviewId])
}
