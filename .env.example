# --- GitHub App ---
GITHUB_APP_ID=
# Local dev: path to the downloaded .pem private key file (kept out of git via .gitignore)
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# Production only: PEM contents as a single env var instead of a file (leave unset locally)
# GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Local dev only: smee.io channel URL that forwards GitHub webhook deliveries to localhost.
# Leave unset in production.
WEBHOOK_PROXY_URL=

# --- LLM provider (Vercel AI SDK) ---
# Which provider serves the review call: google | groq | anthropic
# Only the API key for the selected provider needs to be set below.
LLM_PROVIDER=google
# Model id for the selected provider. Leave unset to use the per-provider
# default (google -> gemini-flash-latest, groq -> openai/gpt-oss-120b,
# anthropic -> claude-opus-5). Groq deprecates models with little notice -
# if the groq default starts 404ing, check GET /openai/v1/models with your
# GROQ_API_KEY for a current large model with "structured_outputs" support.
LLM_MODEL=
# Retries PER PROVIDER (with exponential backoff) before giving up on it and
# falling over to the next one. Default 1 = 2 attempts total. Keep this
# small - a 429 (rate/quota) or 503 (overloaded) won't resolve within one
# provider's own backoff schedule, so failing over fast beats waiting it out.
LLM_MAX_RETRIES=1
# Hard cap, in seconds, on one review call across every attempt and every
# fallback provider combined. Once hit, the in-flight request is aborted and
# the job fails outright rather than trying further providers.
LLM_REVIEW_TIMEOUT_SECONDS=90
# Comma-separated list of providers to try, in order, if LLM_PROVIDER
# exhausts LLM_MAX_RETRIES on a retryable error (429/503/timeout). Each
# fallback uses its own default model. Needs an API key set below for every
# provider listed here too. Leave blank to disable fallback.
LLM_FALLBACK_PROVIDERS=

# Required if LLM_PROVIDER=google (the default), or if google is listed in LLM_FALLBACK_PROVIDERS
GOOGLE_GENERATIVE_AI_API_KEY=
# Required if LLM_PROVIDER=groq, or if groq is listed in LLM_FALLBACK_PROVIDERS
GROQ_API_KEY=
# Required if LLM_PROVIDER=anthropic, or if anthropic is listed in LLM_FALLBACK_PROVIDERS
ANTHROPIC_API_KEY=

# --- Voyage (needed from Milestone 3 onward, not used in M1) ---
VOYAGE_API_KEY=

# --- Postgres (Neon) ---
# Pooled connection string, used by Prisma at runtime
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma Migrate and by
# pg-boss (the job queue - it manages its own "pgboss" schema on this same
# database and needs long-lived polling connections a transaction pooler breaks).
DIRECT_URL=

# --- App config ---
# Port the github-app webhook receiver listens on
PORT=3000
# Max bytes of diff text sent to the LLM per review (configurable safety cap)
MAX_DIFF_BYTES=60000
# missing_test findings are noisy in diff-only mode (no repo-wide visibility
# to confirm a test suite actually exists for the touched code) - off by default.
REPORT_MISSING_TESTS=false

# --- Milestone 2: benchmark miner (evals/dataset/) ---
# A plain GitHub Personal Access Token, NOT the App credentials above - the
# App's installation token only reads repos it's installed on, but the miner
# reads public OSS repos (axios, requests, etc.) you haven't installed it on.
# Generate a fine-grained PAT scoped to "Public Repositories (read-only)" -
# needs no special permissions, just bumps you from 60 to 5000 req/hr.
GITHUB_MINER_TOKEN=

# --- Milestone 5: apps/web dashboard ---
# openssl rand -base64 32
AUTH_SECRET=
# Explicit, not inferred - avoids any mismatch between the two OAuth legs.
AUTH_URL=http://localhost:3001
# github.com/settings/developers -> OAuth Apps -> New OAuth App. This is a
# separate registration from GITHUB_APP_ID above (a GitHub OAuth App, not a
# GitHub App) - it's only used for signing into this dashboard, never for
# reading repos or posting reviews. Authorization callback URL:
# http://localhost:3001/api/auth/callback/github in dev - port 3001, not
# 3000, since apps/github-app's webhook receiver already owns 3000.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Your GitHub username (the "login" field, not display name) - the signIn
# callback rejects every other GitHub account.
ALLOWED_GITHUB_LOGIN=
