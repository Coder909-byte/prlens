# --- GitHub App ---
GITHUB_APP_ID=
# Local dev: path to the downloaded .pem private key file (kept out of git via .gitignore)
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# Production only: PEM contents as a single env var instead of a file (leave unset locally)
# GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Local dev only: smee.io channel URL that forwards GitHub webhook deliveries to localhost.
# Leave unset in production.
WEBHOOK_PROXY_URL=

# --- LLM provider (Vercel AI SDK) ---
# Which provider serves the review call: google | groq | anthropic
# Only the API key for the selected provider needs to be set below.
LLM_PROVIDER=google
# Model id for the selected provider. Leave unset to use the per-provider
# default (google -> gemini-flash-latest, groq -> llama-3.3-70b-versatile,
# anthropic -> claude-opus-5).
LLM_MODEL=
# Max retries (with exponential backoff) for retryable provider errors,
# including HTTP 429 rate limits.
LLM_MAX_RETRIES=5

# Required if LLM_PROVIDER=google (the default)
GOOGLE_GENERATIVE_AI_API_KEY=
# Required if LLM_PROVIDER=groq
GROQ_API_KEY=
# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Voyage (needed from Milestone 3 onward, not used in M1) ---
VOYAGE_API_KEY=

# --- Postgres (Neon) ---
# Pooled connection string, used by Prisma at runtime
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma Migrate and by
# pg-boss (the job queue - it manages its own "pgboss" schema on this same
# database and needs long-lived polling connections a transaction pooler breaks).
DIRECT_URL=

# --- App config ---
# Port the github-app webhook receiver listens on
PORT=3000
# Max bytes of diff text sent to the LLM per review (configurable safety cap)
MAX_DIFF_BYTES=60000
